<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <% if (NODE_ENV.includes('dev')) { %>
    <script>
      //Get current hostname and port from browser
      const host = window.location.hostname;
      const currentPort = window.location.port;

      // Calculate WebSocket port (current port + 1)
      const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;

      //Create WebSocket connect using dynamic hostname and port
      const ws = new WebSocket(`ws://${host}:${wsPort}`);
      ws.onclose = () => {
        setTimeout(() => location.reload(), 2000);
      };
    </script>
    <% } %>

    <%- renderStyles() %>
    <%- renderScripts() %>
</head>
<body>
  <header>
    <nav>
      <ul>
        <!-- Always Visible -->
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/catalog">Course Catalog</a></li>
        <li><a href="/faculty">Faculty Directory</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/demo">Middleware Demo</a></li>
      
        <!-- Only visible if logged in -->
        <% if (isLoggedIn) {%>
          <li><a href="/dashboard">Dashboard</a></li>
          <li><a href="/register/list">Registered Users</a></li>
          <li><a href="/contact/responses">Contact Responses</a></li>
          <li><a href="/logout">Logout</a></li>
        <% } %>

        <!-- Only visible if NOT logged in -->
        <% if (!isLoggedIn) { %>
          <li><a href="/login">Login</a></li>
          <li><a href="/register">Register</a></li>
        <% } %>
      </ul>
    </nav>
  </header>
  <p><%- greeting %></p>
</body>
</html>