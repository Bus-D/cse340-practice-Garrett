<%- include('partials/header') %>

<main>
  <h1>Course Catalog</h1>
  <p>Browse our available courses and click on any course to see detailed information including available sections and instructors.</p>

  <div class="sections">
    <div class="sections-header">
      <h2>Available Departments</h2>
      <div class="sort-options">
        <span>Sort By:</span>
        <a href="/catalog/<%= course.id %>" class="<%= currentSort === 'time' ? 'active' : '' %>">No Sort</a>
        <a href="/catalog/<%= course.id %>" class="<%= currentSort === 'Computer Science' ? 'active' : '' %>">CSE</a>
        <a href="/catalog/<%= course.id %>" class="<%= currentSort === 'English' ? 'active' : '' %>">ENG</a>
        <a href="/catalog/<%= course.id %>" class="<% currentSort === 'History' ? 'active' : '' %>">HIST</a>
      </div>
    </div>
  </div>

  <div class="course-list">
    <% Object.values(course).forEach(course => { %>
      <div class="course-card">
        <h3><a href="/catalog/<%= course.id %>"><%= course.title %></a></h3>
        <p class="course-id"><%= course.id %> • <%=course.credits %></p>
        <p class="course-description"><%= course.description %></p>
      </div>
    <% }); %>
  </div>
</main>

<%- include('partials/footer') %>