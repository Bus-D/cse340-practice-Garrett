<%- include('../partials/header') %>

<main>
    <h1>Faculty List</h2>
    <p>Browse the list of CSE Faculty</p>

    <div class="sections">
        <div class="sections-header">
            <h2>Available Filters</h2>
            <div class="sort-options">
                <span>Sort By:</span>
                <a href="/faculty/list?sort=name" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
                <a href="/faculty/list?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
                <a href="/faculty/list?sort=department" class="<%= currentSort === 'department' ? 'active' : '' %>">Department</a>

            </div>
        </div>
    </div>

    <div class="course-list">
        <% Object.values(faculty).forEach(teacher => { %>
        <div class="course-card">
            <img class="faculty-photo" src="/images/faculty/<%= teacher.slug %>.jpg" alt="<%=teacher.name %>">
            <h3><a href="/faculty/<%= teacher.slug %>"><%= teacher.name %></a></h3>
            <p class="course-id"><%= teacher.title %> • <%= teacher.department %></p>
        </div>
        <% }) %>
    </div>
</main>
 
<%- include('../partials/footer') %>